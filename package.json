{
  "name": "cookbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/build-images.mjs",
    "predev": "npm run images",
    "dev": "vite",
    "prebuild": "npm run images",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-cookbook \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "npx -y firebase-tools@15 emulators:start --only firestore,auth --project demo-cookbook",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"vite-plugins/**/*.ts\" \"scripts/**/*.mjs\" \"e2e/**/*.{ts,mjs}\" \"rules/**/*.ts\" \"*.config.ts\""
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "cmdk": "^1.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright-core": "1.56.1",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
